# Contrail configuration.
#
# Every value here has a working default. Copy this to .env only when you want
# to change something. With no .env at all the stack runs in replay mode
# against the bundled fixtures.

# ----------------------------------------------------------------- source
# replay = recorded fixtures, no credentials, no network (default)
# live   = the OpenSky REST API
CONTRAIL_SOURCE=replay

# OpenSky API client credentials.
#
# Create these at https://opensky-network.org/my-opensky/api-clients. They are
# NOT your account username and password. Basic auth was removed in March 2026;
# only the OAuth2 client credentials flow works now.
#
# Leaving these blank still works: the API serves anonymous callers, but the
# daily allowance drops from 4000 credits to 400 and data resolution coarsens
# from 5s to 10s.
CONTRAIL_OPENSKY_CLIENT_ID=
CONTRAIL_OPENSKY_CLIENT_SECRET=

# Daily credit allowance. "auto" infers it from whether credentials are set.
# Set to 8000 only if your ADS-B receiver is a registered active feeder.
CONTRAIL_QUOTA=auto

# ---------------------------------------------------------------- regions
# JSON array of named bounding boxes. Omit to use the built-in European set.
# Cost per poll is set by area: <=25 sq deg costs 1 credit, <=100 costs 2,
# <=400 costs 3, larger or global costs 4.
#
# CONTRAIL_REGIONS=[{"name":"london","box":{"LatMin":50.5,"LonMin":-1.5,"LatMax":52.5,"LonMax":1.5}}]

# ------------------------------------------------------------------- sink
# kafka | stdout
CONTRAIL_SINK=kafka
CONTRAIL_KAFKA_BROKERS=localhost:19092
CONTRAIL_KAFKA_TOPIC=opensky.states.raw

# ----------------------------------------------------------------- replay
CONTRAIL_FIXTURES_DIR=fixtures
CONTRAIL_REPLAY_LOOP=true
# Rebase recorded timestamps onto the current clock so a capture looks live.
CONTRAIL_REPLAY_TIME_SHIFT=true
# Replay spends no credits, so it is paced by this rather than by the budget.
CONTRAIL_REPLAY_INTERVAL=1s

# ------------------------------------------------------------------ misc
CONTRAIL_POLL_TIMEOUT=90s
CONTRAIL_LOG_EVERY_POLL=true
